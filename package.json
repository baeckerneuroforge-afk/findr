{
  "name": "findr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:ui": "vitest --ui src",
    "eval": "vitest run evals/runner.eval.ts",
    "eval:report": "vitest run evals/runner.eval.ts --reporter=verbose",
    "eval:health": "vitest run evals/health-runner.eval.ts",
    "eval:product-discovery": "env -u ANTHROPIC_API_KEY tsx --conditions=react-server evals-product-discovery/run.ts",
    "eval:save-play": "tsx --conditions=react-server evals-save-play/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@clerk/nextjs": "^7.3.5",
    "@react-spring/web": "^10.0.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^12.39.0",
    "geist": "^1.7.0",
    "next": "16.2.6",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.6",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}

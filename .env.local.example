# ─────────────────────────────────────────────────────────────────────────────
# Findr — local environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Clerk (Auth + Organizations) ────────────────────────────────────────────
# Get from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk routing (these match the routes scaffolded under src/app/(auth)/...)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/create-org

# ─── Supabase (Postgres + pgvector) ──────────────────────────────────────────
# Get from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Service role key — bypasses RLS. Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ─── Anthropic Claude ────────────────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ─── LiveKit (Voice-Interviews — Phase 1) ────────────────────────────────────
# Get from https://cloud.livekit.io → your project → Settings → Keys.
# LIVEKIT_URL is the wss:// server URL handed to participants by
# POST /api/voice/token (response field serverUrl).
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# Explicit agent dispatch: must match the agent_name the Python LiveKit
# voice-agent worker registers with.
VOICE_AGENT_NAME=findr-voice-agent

# Shared secret the voice-agent worker presents to the agent-side bridge
# routes (/api/voice/session-context|transcript|complete) as
# `Authorization: Bearer <secret>`. Treat like a service-role key.
# Generate e.g. with: openssl rand -base64 32
VOICE_AGENT_SHARED_SECRET=

# ─── Hubspot OAuth ───────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback

# ─── Gong OAuth ──────────────────────────────────────────────────────────────
# These three vars must also be set in Vercel before "Connect Gong" works.
GONG_CLIENT_ID=
GONG_CLIENT_SECRET=
GONG_REDIRECT_URI=http://localhost:3000/api/integrations/gong/callback

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Stripe (billing — wire up later) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Inngest (background jobs — wire up later) ───────────────────────────────
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=signkey-xxx

# ─────────────────────────────────────────────────────────────────────────────
# Klymeo — local environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Auth (NextAuth v5 + Zitadel OIDC) ───────────────────────────────────────
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=

# Zitadel Web-App credentials (Authorization Code + PKCE S256, Auth method Basic).
# Provider id is "zitadel" → NextAuth infers these exact env names automatically.
AUTH_ZITADEL_ID=
AUTH_ZITADEL_SECRET=
AUTH_ZITADEL_ISSUER=https://auth.klymeo.com

# Canonical app URL for callback-URL detection. NextAuth v5 reads AUTH_URL;
# NEXTAUTH_URL is kept as a compatibility alias. Locally use http://localhost:3000.
AUTH_URL=https://www.klymeo.com
NEXTAUTH_URL=https://www.klymeo.com

# ─── Supabase (Postgres + pgvector) ──────────────────────────────────────────
# Get from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Service role key — bypasses RLS. Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ─── Anthropic Claude ────────────────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ─── LiveKit (Voice-Interviews — Phase 1) ────────────────────────────────────
# Get from https://cloud.livekit.io → your project → Settings → Keys.
# LIVEKIT_URL is the wss:// server URL handed to participants by
# POST /api/voice/token (response field serverUrl).
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# Explicit agent dispatch: must match the agent_name the Python LiveKit
# voice-agent worker registers with.
VOICE_AGENT_NAME=findr-voice-agent

# Shared secret the voice-agent worker presents to the agent-side bridge
# routes (/api/voice/session-context|transcript|complete) as
# `Authorization: Bearer <secret>`. Treat like a service-role key.
# Generate e.g. with: openssl rand -base64 32
VOICE_AGENT_SHARED_SECRET=

# ─── Hubspot OAuth ───────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback

# ─── Gong OAuth ──────────────────────────────────────────────────────────────
# These three vars must also be set in Vercel before "Connect Gong" works.
GONG_CLIENT_ID=
GONG_CLIENT_SECRET=
GONG_REDIRECT_URI=http://localhost:3000/api/integrations/gong/callback

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Email (Resend) — participant invites + account check-in mails ───────────
# Get from https://resend.com → API Keys
RESEND_API_KEY=re_xxx
# Sender from a Resend-VERIFIED domain. REQUIRED in production: without it the
# app refuses to send (it will NOT fall back to the shared sandbox sender, which
# can't reach participants). Local dev may leave it unset.
INTERVIEW_FROM_EMAIL=Klymeo <noreply@your-domain.example>

# ─── Public URLs & contact (env-driven — domain is config, not code) ─────────
# App base URL for participant interview links (falls back to VERCEL_URL, then
# http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical marketing-site URL: drives metadataBase, OG/Twitter, sitemap, robots
# host, JSON-LD. Falls back to a placeholder until set.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# External Cal.com booking link for every "Demo buchen" CTA (and the /demo
# page). Overrides the in-code fallback in src/lib/marketing/constants.ts —
# keep it in sync with that fallback, or leave it unset to use the fallback.
NEXT_PUBLIC_DEMO_BOOKING_URL=https://cal.eu/klymeoai/demo
# Billing/contact email on the settings → billing page.
NEXT_PUBLIC_BILLING_EMAIL=billing@your-domain.example

# ─── Stripe (billing — wire up later) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Inngest (background jobs — wire up later) ───────────────────────────────
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=signkey-xxx
